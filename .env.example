# Copy to .env if you need to override anything. BowlSense is 100% local: there are no
# API keys or cloud credentials. Settings live in config/default.yaml.

# Path to the YAML config (defaults to config/default.yaml in the repo)
BOWLSENSE_CONFIG=

# 1 = block every network connection to anything other than localhost (offline guarantee)
BOWLSENSE_OFFLINE=0

# Telemetry off for every library
YOLO_OFFLINE=1
NEXT_TELEMETRY_DISABLED=1

# Ports and addresses. run.py sets these itself (and picks the next free port if one is busy);
# set them only when starting the API / worker / web app by hand.
BOWLSENSE_API_PORT=8000
BOWLSENSE_WEB_PORT=3000
# The web app reads this per request (must be a 127.0.0.1/localhost URL)
BOWLSENSE_API_URL=http://127.0.0.1:8000

# 1 = never use the GPU, even if CUDA is available (same as "GPU off" on the Settings page)
BOWLSENSE_DISABLE_GPU=0

# Internal: set by run.py when it re-launches itself inside ml/.venv. Leave unset.
# BOWLSENSE_RUN_CHILD=
