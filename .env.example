# Copy to .env and fill in. Never commit .env.

# Path to the YAML config (defaults to config/default.yaml in the repo)
BOWLSENSE_CONFIG=

# Database backend: sqlite (local/offline) or supabase
BOWLSENSE_DB=sqlite
# SQLite file path (defaults to ~/.cache/bowlsense/bowlsense.db)
BOWLSENSE_SQLITE_PATH=

# Model weight cache (defaults to ~/.cache/bowlsense)
BOWLSENSE_CACHE_DIR=

# Anthropic API key for the LLM coach. Optional: without it a template report is used.
ANTHROPIC_API_KEY=

# Supabase (server side only; the service-role key must never reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web origin allowed by the ML service CORS policy
BOWLSENSE_WEB_ORIGIN=http://localhost:3000
