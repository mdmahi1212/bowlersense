  "$defs": {
    "AlignmentResult": {
      "additionalProperties": false,
      "description": "Module B: shoulder and hip alignment through the delivery stride.\n\nAngles are yaw about the vertical axis: 0 = side-on (body line pointing down the pitch),\n90 = front-on, negative = turned past side-on. ``None`` means not measurable from this\ncamera view (see ``notes``).",
      "properties": {
        "action_type": {
          "enum": [
            "side_on",
            "semi_open",
            "front_on",
            "mixed",
            "unknown"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "shoulder_angle_bfc_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Shoulder Angle Bfc Deg"
        },
        "hip_angle_bfc_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hip Angle Bfc Deg"
        },
        "hip_shoulder_diff_bfc_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hip Shoulder Diff Bfc Deg"
        },
        "counter_rotation_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counter Rotation Deg"
        },
        "counter_rotation_flagged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Counter Rotation Flagged"
        },
        "hip_shoulder_sep_ffc_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hip Shoulder Sep Ffc Deg"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "action_type",
        "shoulder_angle_bfc_deg",
        "hip_angle_bfc_deg",
        "hip_shoulder_diff_bfc_deg",
        "counter_rotation_deg",
        "counter_rotation_flagged",
        "hip_shoulder_sep_ffc_deg"
      ],
      "title": "AlignmentResult",
      "type": "object"
    },
    "AngleSeries": {
      "additionalProperties": false,
      "description": "A named angle over time.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "const": "deg",
          "default": "deg",
          "title": "Unit",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        },
        "frames": {
          "items": {
            "type": "integer"
          },
          "title": "Frames",
          "type": "array"
        }
      },
      "required": [
        "name",
        "values",
        "frames"
      ],
      "title": "AngleSeries",
      "type": "object"
    },
    "BallMetrics": {
      "additionalProperties": false,
      "description": "Module F: speed, length, line and pitch position (``None`` = not measurable, see\n``notes``).",
      "properties": {
        "speed_kmh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Speed Kmh"
        },
        "length": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Length"
        },
        "line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line"
        },
        "pitch_xy": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pitch Xy"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "speed_kmh",
        "length",
        "line",
        "pitch_xy",
        "notes"
      ],
      "title": "BallMetrics",
      "type": "object"
    },
    "BallTrack": {
      "additionalProperties": false,
      "description": "Ball positions over time: (frame, x, y, conf).",
      "properties": {
        "points": {
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Points",
          "type": "array"
        },
        "release_frame": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Frame"
        },
        "bounce_frame": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bounce Frame"
        }
      },
      "required": [
        "points"
      ],
      "title": "BallTrack",
      "type": "object"
    },
    "ConsistencyResult": {
      "additionalProperties": false,
      "description": "Consistency across a session's deliveries (module G).",
      "properties": {
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "variation_pct": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Variation Pct",
          "type": "object"
        },
        "n_deliveries": {
          "minimum": 0,
          "title": "N Deliveries",
          "type": "integer"
        }
      },
      "required": [
        "variation_pct",
        "n_deliveries"
      ],
      "title": "ConsistencyResult",
      "type": "object"
    },
    "DeliveryAnalysis": {
      "additionalProperties": false,
      "description": "Modules A-D (and E's per-delivery inputs) for one delivery.",
      "properties": {
        "height_px": {
          "title": "Height Px",
          "type": "number"
        },
        "phases": {
          "$ref": "#/$defs/PhaseEvents"
        },
        "legality": {
          "$ref": "#/$defs/LegalityResult"
        },
        "alignment": {
          "$ref": "#/$defs/AlignmentResult"
        },
        "faults": {
          "$ref": "#/$defs/FaultReport"
        },
        "injury": {
          "$ref": "#/$defs/InjuryRisk"
        },
        "fatigue_input": {
          "$ref": "#/$defs/FatigueInput"
        },
        "delivery_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryTypeResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "release_source": {
          "default": "rules",
          "enum": [
            "rules",
            "model"
          ],
          "title": "Release Source",
          "type": "string"
        },
        "ball": {
          "anyOf": [
            {
              "$ref": "#/$defs/BallMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ball_track": {
          "anyOf": [
            {
              "$ref": "#/$defs/BallTrack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "comparisons": {
          "items": {
            "$ref": "#/$defs/ReferenceComparison"
          },
          "title": "Comparisons",
          "type": "array"
        }
      },
      "required": [
        "height_px",
        "phases",
        "legality",
        "alignment",
        "faults",
        "injury",
        "fatigue_input"
      ],
      "title": "DeliveryAnalysis",
      "type": "object"
    },
    "DeliveryMetrics": {
      "additionalProperties": false,
      "description": "Everything measured for one delivery.\n\nPhase frames and ``angles`` frames are numbered within the delivery's clip;\n``clip_start`` is the clip's first frame in the source video. ``None`` = not measurable\nfrom this camera view.",
      "properties": {
        "delivery_idx": {
          "minimum": 0,
          "title": "Delivery Idx",
          "type": "integer"
        },
        "phases": {
          "$ref": "#/$defs/PhaseEvents"
        },
        "action_type": {
          "title": "Action Type",
          "type": "string"
        },
        "legality": {
          "$ref": "#/$defs/LegalityResult"
        },
        "faults": {
          "items": {
            "$ref": "#/$defs/Fault"
          },
          "title": "Faults",
          "type": "array"
        },
        "technique_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Technique Score",
          "type": "number"
        },
        "injury": {
          "$ref": "#/$defs/InjuryRisk"
        },
        "speed_kmh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Kmh"
        },
        "length": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length"
        },
        "line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "pitch_xy": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch Xy"
        },
        "release_height_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Height Pct"
        },
        "stride_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stride Pct"
        },
        "angles": {
          "items": {
            "$ref": "#/$defs/AngleSeries"
          },
          "title": "Angles",
          "type": "array"
        },
        "clip_start": {
          "default": 0,
          "minimum": 0,
          "title": "Clip Start",
          "type": "integer"
        },
        "clip_stop": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Stop"
        },
        "alignment": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlignmentResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fault_measurements": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Fault Measurements",
          "type": "object"
        },
        "not_measured": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Not Measured",
          "type": "object"
        },
        "delivery_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryTypeResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "release_source": {
          "default": "rules",
          "enum": [
            "rules",
            "model"
          ],
          "title": "Release Source",
          "type": "string"
        },
        "ball_notes": {
          "items": {
            "type": "string"
          },
          "title": "Ball Notes",
          "type": "array"
        },
        "ball_track": {
          "anyOf": [
            {
              "$ref": "#/$defs/BallTrack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "comparisons": {
          "items": {
            "$ref": "#/$defs/ReferenceComparison"
          },
          "title": "Comparisons",
          "type": "array"
        },
        "keyframes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Keyframes",
          "type": "object"
        }
      },
      "required": [
        "delivery_idx",
        "phases",
        "action_type",
        "legality",
        "faults",
        "technique_score",
        "injury",
        "angles"
      ],
      "title": "DeliveryMetrics",
      "type": "object"
    },
    "DeliveryTypeResult": {
      "additionalProperties": false,
      "description": "Pace or spin (learned classifier), with the probability of pace.",
      "properties": {
        "delivery_type": {
          "enum": [
            "fast",
            "spin"
          ],
          "title": "Delivery Type",
          "type": "string"
        },
        "p_fast": {
          "maximum": 1,
          "minimum": 0,
          "title": "P Fast",
          "type": "number"
        }
      },
      "required": [
        "delivery_type",
        "p_fast"
      ],
      "title": "DeliveryTypeResult",
      "type": "object"
    },
    "FatigueDrift": {
      "additionalProperties": false,
      "description": "Percent change of one delivery's metrics versus the session baseline.",
      "properties": {
        "delivery_idx": {
          "minimum": 0,
          "title": "Delivery Idx",
          "type": "integer"
        },
        "runup_speed_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Runup Speed Pct"
        },
        "release_height_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Release Height Pct"
        },
        "wrist_speed_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wrist Speed Pct"
        },
        "technique_score_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Technique Score Pct"
        },
        "fault_count_delta": {
          "title": "Fault Count Delta",
          "type": "integer"
        },
        "fatigue_index": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fatigue Index"
        }
      },
      "required": [
        "delivery_idx",
        "runup_speed_pct",
        "release_height_pct",
        "wrist_speed_pct",
        "technique_score_pct",
        "fault_count_delta"
      ],
      "title": "FatigueDrift",
      "type": "object"
    },
    "FatigueInput": {
      "additionalProperties": false,
      "description": "Per-delivery numbers the fatigue module tracks. ``None`` = not measured.",
      "properties": {
        "delivery_idx": {
          "minimum": 0,
          "title": "Delivery Idx",
          "type": "integer"
        },
        "runup_speed_h_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runup Speed H S"
        },
        "release_height_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Height Pct"
        },
        "wrist_speed_h_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wrist Speed H S"
        },
        "technique_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technique Score"
        },
        "fault_count": {
          "minimum": 0,
          "title": "Fault Count",
          "type": "integer"
        }
      },
      "required": [
        "delivery_idx",
        "fault_count"
      ],
      "title": "FatigueInput",
      "type": "object"
    },
    "FatigueResult": {
      "additionalProperties": false,
      "description": "Session-level fatigue trend.",
      "properties": {
        "baseline_deliveries": {
          "minimum": 0,
          "title": "Baseline Deliveries",
          "type": "integer"
        },
        "drifts": {
          "items": {
            "$ref": "#/$defs/FatigueDrift"
          },
          "title": "Drifts",
          "type": "array"
        },
        "fatigue_index": {
          "maximum": 100,
          "minimum": 0,
          "title": "Fatigue Index",
          "type": "number"
        },
        "alert": {
          "title": "Alert",
          "type": "boolean"
        },
        "alert_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Alert Reasons",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "baseline_deliveries",
        "drifts",
        "fatigue_index",
        "alert",
        "alert_reasons"
      ],
      "title": "FatigueResult",
      "type": "object"
    },
    "Fault": {
      "additionalProperties": false,
      "description": "A detected technique fault.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "severity": {
          "maximum": 100,
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "frames": {
          "items": {
            "type": "integer"
          },
          "title": "Frames",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "code",
        "name",
        "severity",
        "value",
        "threshold",
        "frames",
        "explanation"
      ],
      "title": "Fault",
      "type": "object"
    },
    "FaultReport": {
      "additionalProperties": false,
      "description": "Module C: technique faults for one delivery.\n\n``measurements`` holds the value behind every fault that could be measured from this\ncamera view (fired or not); ``not_measured`` maps the other codes to the reason.",
      "properties": {
        "faults": {
          "items": {
            "$ref": "#/$defs/Fault"
          },
          "title": "Faults",
          "type": "array"
        },
        "measurements": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Measurements",
          "type": "object"
        },
        "not_measured": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Not Measured",
          "type": "object"
        },
        "technique_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Technique Score",
          "type": "number"
        }
      },
      "required": [
        "faults",
        "measurements",
        "not_measured",
        "technique_score"
      ],
      "title": "FaultReport",
      "type": "object"
    },
    "FramePose": {
      "additionalProperties": false,
      "description": "All keypoints of the bowler in one frame. A missing joint maps to ``None``.",
      "properties": {
        "frame_idx": {
          "minimum": 0,
          "title": "Frame Idx",
          "type": "integer"
        },
        "t": {
          "description": "Seconds from the start of the video",
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "keypoints": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Keypoint"
              },
              {
                "type": "null"
              }
            ]
          },
